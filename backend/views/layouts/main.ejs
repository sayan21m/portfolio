<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body<% if (bodyClass) { %> class="<%= bodyClass %>"<% } %>>
  <% if (includeSkipLink) { %>
  <a href="#main" class="skip-link">Skip to main content</a>
  <% } %>

  <% if (showScrollProgress) { %>
  <div
    class="scroll-progress"
    id="scroll-progress"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-label="Page scroll progress"
  >
    <div class="scroll-progress__bar" id="scroll-progress-bar"></div>
  </div>
  <% } %>

  <% if (nav === 'home') { %>
    <%- include('../partials/nav-home') %>
  <% } else if (nav === 'sub') { %>
    <%- include('../partials/nav-sub') %>
  <% } %>

  <%- include('../' + contentView) %>

  <% if (footerVariant !== 'none') { %>
    <%- include('../partials/footer') %>
  <% } %>

  <% if (showBackToTop) { %>
  <button
    class="back-to-top"
    id="back-to-top"
    aria-label="Back to top"
    hidden
  >
    <svg class="back-to-top__ring" viewBox="0 0 52 52" aria-hidden="true">
      <circle
        class="back-to-top__ring-bg"
        cx="26"
        cy="26"
        r="22"
        fill="none"
        stroke-width="3"
      />
      <circle
        class="back-to-top__ring-progress"
        id="back-to-top-progress"
        cx="26"
        cy="26"
        r="22"
        fill="none"
        stroke-width="3"
        stroke-linecap="round"
        transform="rotate(-90 26 26)"
      />
    </svg>
    <span data-icon="chevron-up" class="icon back-to-top__icon"></span>
  </button>
  <% } %>

  <% if (showDownloadToast) { %>
  <div
    id="download-toast"
    class="download-toast"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    Download started — check your browser downloads.
  </div>
  <% } %>

  <%- include('../partials/scripts') %>
  <%- extraScripts %>
</body>
</html>
